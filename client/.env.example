# ─────────────────────────────────────────────────────────
# PracHub Client — Variables de Entorno (Vite)
# Copia este archivo a .env y rellena los valores reales.
# Solo se exponen al cliente las vars con prefijo VITE_.
# NUNCA subas .env al repositorio.
# ─────────────────────────────────────────────────────────

# URL base de la API backend
VITE_API_URL=http://localhost:4000/api

# Clave de acceso al portal de administradores (primera puerta).
# Debe coincidir con ADMIN_ACCESS_SECRET en el servidor.
VITE_ADMIN_PORTAL_KEY=change-this-admin-portal-key
